# Public API (optional — production has a safe default)
NEXT_PUBLIC_API_URL=https://sentinel-ledger-backend-production.up.railway.app
NEXT_PUBLIC_WS_URL=wss://sentinel-ledger-backend-production.up.railway.app
# Optional Vercel serverless OpenAI agent endpoint: POST /api/openai/sentinel-agent.
# Prefer the Railway backend endpoint unless you intentionally deploy this route on Vercel.
OPENAI_API_KEY=
SENTINEL_AGENT_SECRET=
OPENAI_SENTINEL_AGENT_MODEL=gpt-4o-mini
# Local dev proxy target for next.config.js rewrites. Leave NEXT_PUBLIC_API_URL empty
# locally to call /api/* through this proxy, or point NEXT_PUBLIC_API_URL at a real backend.
# Do not point NEXT_PUBLIC_API_URL at the frontend port.
# NEXT_PUBLIC_API_PROXY_TARGET=http://localhost:3001

# Optional: dedicated Solana RPC for the browser (no Helius secret here; use a public or paid RPC URL you control)
NEXT_PUBLIC_SOLANA_RPC_URL=

# WalletConnect Cloud project ID → enables mobile / Binance-style flows in the wallet modal
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Canonical site URL for WalletConnect metadata (defaults to Vercel prod if unset)
NEXT_PUBLIC_SITE_URL=https://sentinel-ledger-ochre.vercel.app

# Footer / social — full profile URL with @handle (NOT bare https://x.com)
# Example: https://x.com/SentinelLedger
NEXT_PUBLIC_X_URL=

# Alias (optional): NEXT_PUBLIC_TWITTER_URL=

# Stripe success/cancel redirects (optional; backend also uses SENTINEL_APP_URL)
NEXT_PUBLIC_APP_URL=https://sentinel-ledger-ochre.vercel.app

# Telegram Login Widget — Bot username (no @) for /alerts PRO linking. Set the same domain in @BotFather /setdomain.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# --- /ops page (production) ---
# If OPS_PAGE_GATE_TOKEN is set, /ops ALWAYS uses the gate below; NEXT_PUBLIC_OPS_PAGE_ENABLED / OPS_PAGE_ENABLED are IGNORED.
# Remove those legacy vars from Vercel unless you intentionally want public /ops (no gate token only).
# Legacy: set to 1 so ANYONE can open /ops — only when OPS_PAGE_GATE_TOKEN is unset (not recommended).
# NEXT_PUBLIC_OPS_PAGE_ENABLED=1
# OPS_PAGE_ENABLED=1

# Secret for operator-only access. When public flags are off, open once:
#   https://your-app.vercel.app/ops?ops_gate=YOUR_TOKEN
# That sets an httpOnly cookie; bookmark /ops after. Do NOT use NEXT_PUBLIC_ for this.
# OPS_PAGE_GATE_TOKEN=

# Show "Ops" in nav + footer (still needs gate or public flag to load /ops in prod).
# NEXT_PUBLIC_SHOW_OPS_NAV=1

# Server-only: must match Railway OMNI_BOT_OPS_KEY. Used by /api/ops-bridge — the browser never sees it.
# OMNI_BOT_OPS_KEY=
